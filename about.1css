/* === HERO BANNER === */
.hero-banner {
    background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url('https://images.unsplash.com/photo-1625246333195-78d9c38ad449?w=1600');
    background-size: cover;
    background-position: center;
    height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
    padding: 0 20px;
}

.hero-content h1 {
    font-size: 48px;
    margin-bottom: 15px;
}

/* === LEGACY BENTO GRID === */
.legacy-section {
    padding: 80px 5%;
    max-width: 1200px;
    margin: 0 auto;
}

.bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.bento-item {
    border-radius: 12px;
    overflow: hidden;
}

.text-box {
    grid-column: span 2;
    padding: 40px;
    background-color: #ffffff;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
}

.text-box h2 {
    color: #0B5C46;
    margin-bottom: 20px;
}

.image-box {
    grid-column: span 1;
}

.image-box img, .wide-image-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.stats-box {
    grid-column: span 1;
    background-color: #0B5C46;
    color: white;
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.stats-box h3 {
    font-size: 36px;
    margin: 15px 0 5px 0;
}

.wide-image-box {
    grid-column: span 2;
}

/* === TEAM SECTION === */
.team-section {
    background-color: #f8faff;
    padding: 80px 5%;
}

.team-header {
    text-align: center;
    margin-bottom: 50px;
    color: #0B5C46;
}

.team-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
    max-width: 1200px;
    margin: 0 auto;
}

.team-card img {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 15px;
}

.team-card h4 {
    color: #0B5C46;
    margin-bottom: 5px;
}

.team-card p {
    font-size: 14px;
    color: #666;
}

/* === MOBILE RESPONSIVE OVERRIDES === */
@media (max-width: 768px) {
    .bento-grid {
        grid-template-columns: 1fr; /* Stacks the bento box vertically */
    }
    
    .text-box, .image-box, .stats-box, .wide-image-box {
        grid-column: span 1;
    }
    
    .team-grid {
        grid-template-columns: repeat(2, 1fr); /* 2x2 grid for team on tablets */
    }
}

@media (max-width: 480px) {
    .team-grid {
        grid-template-columns: 1fr; /* Stacks team members on small phones */
    }
    
    .hero-content h1 {
        font-size: 32px;
    }
}